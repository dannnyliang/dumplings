# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# supabase branching 的 branch secrets：.env.preview 是 dotenvx 加密後的密文，需進版控
# 讓 branching executor 取用；私鑰 .env.keys 仍被上方的 .env* 擋下，絕不可進版控
!supabase/.env.preview

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.playwright-mcp

# supabase local cache
supabase/.temp/
.env*.local

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
