# 複製成 .env.local 並填入實際值（Supabase Dashboard → Project Settings → API）
# 兩個值都會打包進瀏覽器端（NEXT_PUBLIC_），anon key 受 RLS 保護、可公開。
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Vercel Cron 打 /api/keepalive 時帶的密鑰。Vercel 只在專案設了這個變數時
# 才會附上 Authorization header；本地跑 e2e 由 playwright.config.ts 注入。
CRON_SECRET=<random-string>
